# Porta do servidor Express
PORT=3000
NODE_ENV=development

# Conexão com SQLite
DATABASE_URL="file:./dev.db"

# Token do Bot do Telegram (Obtenha com o @BotFather no Telegram)
TELEGRAM_BOT_TOKEN="SEU_TOKEN_AQUI"

# Configuração de Webhook (opcional - em dev usaremos Polling automático)
# WEBHOOK_URL="https://seu-dominio.com/webhook"
